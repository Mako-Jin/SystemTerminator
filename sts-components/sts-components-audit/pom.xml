                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.yaocode.sts.components.audit</groupId>
                <artifactId>sts-components-audit-storage</artifactId>
                <version>0.0.1-SNAPSHOT</version>
